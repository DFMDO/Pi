
# --- DFM Signage ---
disable_splash=1
boot_delay=0
dtparam=audio=off
hdmi_force_hotplug=1
hdmi_blanking=0
dtoverlay=vc4-kms-v3d
# Genug zusammenhängender Speicher für den Video-Decoder (1080p ohne Ruckler)
[pi3]
dtoverlay=cma,cma-256
[pi4]
dtoverlay=cma,cma-384
[all]
max_framebuffers=2
disable_overscan=1
# Pi 5: Echtzeituhr-Batterie (falls angeschlossen) laden
dtparam=rtc_bbat_vchg=3000000
