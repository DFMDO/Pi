[Unit]
Description=DFM Einrichtungsmodus (Hotspot, QR-Code, Einrichtungsseite)
After=NetworkManager.service dfm-firstboot.service
Requires=NetworkManager.service

[Service]
Environment=DFM_DATA=/data
ExecStart=/usr/lib/dfm/launch setup
Restart=on-failure
RestartSec=3
# Nur dieser Dienst darf das Netzwerk umkonfigurieren – und nur im Einrichtungsmodus
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/data /run/dfm /boot/firmware
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=200M
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
