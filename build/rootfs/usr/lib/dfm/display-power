#!/bin/sh
# Bildschirm an/aus. Grafikstack erkennen (HDMI-CEC, Wayland/cage via wlr-randr, Firmware via vcgencmd).
# Ergebnis steht in /run/dfm/display-power.status („ok“ oder „nicht möglich“) – die Oberfläche zeigt es dem Admin klar an.
STATE="$1"; ST=/run/dfm/display-power.status
case "$STATE" in on|off) ;; *) exit 1 ;; esac
ok() { echo ok > $ST; chmod 644 $ST; exit 0; }
if command -v cec-ctl >/dev/null 2>&1 && [ -e /dev/cec0 ]; then
  if [ "$STATE" = on ]; then cec-ctl -d /dev/cec0 --tv --image-view-on >/dev/null 2>&1 && ok; else cec-ctl -d /dev/cec0 --tv --standby >/dev/null 2>&1 && ok; fi
fi
if command -v wlr-randr >/dev/null 2>&1; then # Pi 4/5 mit cage (Wayland)
  OUT=$(XDG_RUNTIME_DIR=/run/user/991 WAYLAND_DISPLAY=wayland-0 wlr-randr 2>/dev/null | awk 'NR==1{print $1}')
  if [ -n "$OUT" ]; then if [ "$STATE" = on ]; then XDG_RUNTIME_DIR=/run/user/991 wlr-randr --output "$OUT" --on && ok; else XDG_RUNTIME_DIR=/run/user/991 wlr-randr --output "$OUT" --off && ok; fi; fi
fi
if command -v vcgencmd >/dev/null 2>&1 && vcgencmd display_power >/dev/null 2>&1; then
  if [ "$STATE" = on ]; then vcgencmd display_power 1 >/dev/null && ok; else vcgencmd display_power 0 >/dev/null && ok; fi
fi
echo "nicht möglich" > $ST; chmod 644 $ST; exit 3   # Anzeige schaltet dann auf schwarzes Bild
