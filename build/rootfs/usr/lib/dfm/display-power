#!/bin/sh
# Bildschirm an/aus. Grafikstack erkennen; klare Rückmeldung, wenn nicht möglich (Exit 3 → Anzeige zeigt schwarzes Bild).
STATE="$1"
case "$STATE" in on|off) ;; *) exit 1 ;; esac
if command -v cec-ctl >/dev/null 2>&1 && [ -e /dev/cec0 ]; then
  [ "$STATE" = on ] && cec-ctl -d /dev/cec0 --tv --image-view-on || cec-ctl -d /dev/cec0 --tv --standby && exit 0
fi
if command -v wlr-randr >/dev/null 2>&1; then # Wayland (cage) – Pi 4/5
  OUT=$(wlr-randr 2>/dev/null | awk 'NR==1{print $1}')
  [ -n "$OUT" ] && { [ "$STATE" = on ] && wlr-randr --output "$OUT" --on || wlr-randr --output "$OUT" --off; } && exit 0
fi
if command -v vcgencmd >/dev/null 2>&1 && vcgencmd display_power >/dev/null 2>&1; then # Legacy/Firmware-KMS-frei
  [ "$STATE" = on ] && vcgencmd display_power 1 || vcgencmd display_power 0; exit 0
fi
exit 3
