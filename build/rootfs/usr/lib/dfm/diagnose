#!/bin/sh
# Schreibt den Zustand des Geräts als Textdatei auf die Boot-Partition (dfm-diagnose.txt).
# Die Datei lässt sich am Windows-PC direkt lesen: SD-Karte einstecken, Laufwerk "bootfs" öffnen.
# Enthält KEINE Passwörter/Schlüssel/PINs: Zeilen mit solchen Wörtern werden entfernt, die Einrichtungs-Logs fehlen ganz.
set -u
OUT=/boot/firmware/dfm-diagnose.txt
T=$(mktemp /tmp/diag.XXXXXX) || exit 0
clean() { grep -viE 'pass|psk|token|secret|key|pin[^a-z]|pwhash|hash' || true; }
unit() { printf '\n--- %s: %s ---\n' "$1" "$(systemctl is-active "$1" 2>&1)"; journalctl -b -u "$1" -n 25 --no-pager -o short 2>&1 | clean | cut -c1-220; }
{
  echo "DFM Signage - Diagnose"
  echo "Version:   $(cat /etc/dfm/version 2>/dev/null)"
  echo "Betrieb:   $(cat /run/dfm/mode 2>/dev/null) (Rolle laut Einrichtung: $(sed -n 's/.*"role":"\([a-z]*\)".*/\1/p' /data/config.json 2>/dev/null))"
  echo "Hostname:  $(hostname)"
  echo "Laufzeit:  $(uptime -p 2>/dev/null)"
  echo "Modell:    $(tr -d '\0' < /proc/device-tree/model 2>/dev/null)"
  echo; echo "--- Netzwerk ---"; ip -br addr 2>&1 | cut -c1-160
  echo; echo "--- Offene Ports (Zuhoerer) ---"; ss -ltnH 2>&1 | awk '{print $4}' | sort -u
  echo; echo "--- Fehlgeschlagene Dienste ---"; systemctl --failed --no-legend --plain 2>&1
  echo; echo "--- Hardware ---"
  echo "Temperatur:  $(vcgencmd measure_temp 2>/dev/null)"
  echo "Spannung/Drosselung: $(vcgencmd get_throttled 2>/dev/null)  (0x0 = alles gut)"
  df -h / /data /boot/firmware 2>&1 | cut -c1-120
  free -m 2>&1
  echo; echo "--- Laufende Programme (Hub, Agent, Anzeige) ---"; ps -eo user:12,pid,pcpu,rss,args 2>/dev/null | grep -E 'node|cage|chromium|mpv' | grep -v grep | cut -c1-180 | head -15
  echo; echo "--- Anmeldesitzungen / Laufzeitordner ---"; loginctl list-sessions --no-legend 2>&1 | head -5; ls -ld /run/user/* 2>&1 | head -5
  echo; echo "--- Warnungen und Fehler seit dem Start (alle Dienste) ---"; journalctl -b -p warning -n 40 --no-pager -o short 2>&1 | clean | cut -c1-220
  for u in dfm-mode dfm-firstboot dfm-data dfm-hub dfm-agent dfm-privd NetworkManager avahi-daemon nftables; do unit "$u.service"; done
  echo; echo "--- Kernel (letzte Hinweise zu Anzeige/Strom/SD) ---"; dmesg 2>/dev/null | grep -iE 'under-voltage|drm|vc4|mmc.*error|oom|killed process' | tail -15 | cut -c1-200
} > "$T" 2>&1
# Nur schreiben, wenn sich etwas geaendert hat (schont die SD-Karte); die Zeile "Stand" zaehlt nicht mit.
OLD=$(grep -v '^Stand:' "$OUT" 2>/dev/null | tr -d '\r' | cksum)
{ echo "Stand:     $(date '+%d.%m.%Y %H:%M:%S') (Uhrzeit kann bis zur Synchronisierung falsch sein)"; cat "$T"; } | sed 's/$/\r/' > "$T.out"
if [ "$(grep -v '^Stand:' "$T.out" | tr -d '\r' | cksum)" != "$OLD" ]; then
  mount -o remount,rw /boot/firmware 2>/dev/null && cp "$T.out" "$OUT" && sync; mount -o remount,ro /boot/firmware 2>/dev/null
fi
rm -f "$T" "$T.out"; exit 0
